# Research staging is deterministic external evidence, never product history.
research/original-evidence/staging/

# Legal documents contain private terms and signatures. Only their evidence IDs
# and non-sensitive scope metadata belong in the repository.
docs/legal/private/

# Owner-authorized non-public faithful baseline. Rebuilt locally from the
# validated art-production candidates. Default-ignore future research outputs;
# only the exact Owner-approved 2026-09-10 public playtest input list is tracked.
assets/production/internal-faithful-baseline/

# Runtime conversions made directly from the owner-supplied ROM stay local.
# The Pages builder also rejects this directory as a second line of defence.
assets/production/vfx/original-rom-conversion-v1/

