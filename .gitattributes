* text=auto
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.csv text eol=lf
*.png binary
*.webp binary
*.bat text eol=crlf

# Generated art manifests/atlases are byte-hashed by their provenance receipts.
# Preserve those bytes across Windows/Linux checkout rather than rewriting
# their line endings and invalidating the existing image/geometry contracts.
assets/production/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/art/production/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Historical generation prompts are signed receipts, including their final blank line.
docs/art/production/characters/appearance-refresh-v1/batch-01/generation/*-prompt.txt -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
