{
  "vfx-ui-redline-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/guard-vfx-ui.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
