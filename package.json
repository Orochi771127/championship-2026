{
  "name": "championship-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone web/mobile rebuild of Digimon Championship.",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "art:a0:build": "node scripts/build-art-production-a0.mjs",
    "art:a0:validate": "node scripts/validate-art-production-a0.mjs",
    "art:characters:b01:build": "python scripts/build-character-faithful-hd.py --batch 1",
    "art:characters:b01:validate": "python scripts/validate-character-faithful-hd.py",
    "art:characters:all:build": "python scripts/build-character-faithful-hd.py --all",
    "art:characters:all:validate": "python scripts/validate-character-faithful-hd.py --all",
    "art:characters:m201:review:build": "python scripts/build-character-remix-seed-workspace.py",
    "art:characters:m201:review:validate": "node --test tests/championship-character-remix-m201-cases.mjs tests/championship-character-animation-timeline-cases.mjs",
    "art:ui:hd96:build": "python scripts/build-ui-faithful-hd96.py",
    "art:ui:hd96:validate": "python scripts/validate-ui-faithful-hd96.py",
    "art:internal-faithful:build": "node scripts/build-internal-faithful-baseline.mjs",
    "art:internal-faithful:validate": "node scripts/validate-internal-faithful-baseline.mjs",
    "art:vfx:reference26:build": "node scripts/build-vfx-faithful-reference-26.mjs",
    "art:vfx:reference26:validate": "node scripts/validate-vfx-faithful-reference-26.mjs",
    "art:vfx:convert": "node scripts/build-licensed-vfx-conversion-v1.mjs",
    "art:vfx:animations:build": "node scripts/build-vfx-animation-sidecars-v1.mjs",
    "art:vfx:gate-earth:trace": "python scripts/trace-gate-earth-ovl12.py",
    "art:vfx:validate": "node scripts/validate-licensed-vfx-conversion-v1.mjs",
    "battle:catalogs:build": "python scripts/build-battle-catalogs.py",
    "build:pages": "node scripts/build-github-pages.mjs",
    "validate:pages": "node scripts/validate-github-pages.mjs",
    "test": "node --test tests/*.mjs",
    "test:browser": "node tests/championship-int-rh2-browser.cjs",
    "test:browser:vs2": "node tests/championship-vs2-browser.cjs",
    "test:browser:vs2-r1": "node tests/championship-vs2-r1-gate-browser.cjs",
    "test:browser:vs3": "node tests/championship-vs3-browser.cjs",
    "test:browser:file-launch": "node tests/championship-file-launch-guard-browser.cjs",
    "test:browser:vfx": "node tests/championship-faithful-vfx-browser.cjs"
  },
  "dependencies": {
    "pixi.js": "8.19.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
