  "sourceRefs": [],
  "sourceUse": "Original pearl-cyan tideglass sprig with twin indigo kelp ribbons, navy face lens, mint flank, gold eye and coral seed-pod tail; donor supplies motion, timing, bounds and mapping only. No donor RGB or copied source pixels.",
  "features": [
    "珍珠青藍玻璃芽身",
    "雙靛紫海藻帶觸鬚",
    "深海藍臉窗與金色單眼",
    "薄荷側紋與珊瑚種莢尾"
  ],
  "faceRules": [
    "深海藍臉窗必須依 donor 角度壓縮、轉側或遮蔽；張嘴格顯示珊瑚色口腔。",
    "金色單眼只在來源角度可見時出現，不得將同一正面表情複製到所有格。"
  ],
  "ornamentRules": [
    "雙海藻帶觸鬚與單一種莢尾都附著身體並依 donor 彎折、豎起、貼地或捲曲；不得新增手臂、腿、翅膀、角、漂浮物或第二尾。",
    "main026-042 的金色束帶是外部道具，必須跨越身體且不得與薄荷側紋混同。"
  ],
  "identityDesign": {
    "directionVersion": "creature-identity-v1",
    "family": "TIDEGLASS_SPRIG",
    "fixedTraits": [
      "珍珠青藍玻璃芽身",
      "雙靛紫海藻帶觸鬚",
      "深海藍臉窗與金色單眼",
      "薄荷側紋與珊瑚種莢尾"
    ],
    "changedRegions": [
      "全身改為青藍玻璃芽材質",
      "雙長觸鬚改為靛紫海藻帶並以青綠端點收束",
      "臉部改為深海藍臉窗與金色單眼",
      "單尾改為珊瑚種莢尾"
    ],
    "allowedContourChanges": [
      "維持 donor 每格低姿圓身、雙附著長觸鬚、單一捲尾、直立與扁平極值以及本地原點；只在輪廓內重設材質、臉窗與附著紋樣。"
    ],
    "preservedMotion": [
      "低姿搖動與滑行、水平伸展壓縮、緊縮捲曲、斜向轉動、短跳、直立與倒地",
      "雙觸鬚與單尾依 donor 後掠、豎起、貼地或捲曲",
      "臉窗依 donor 表情張合與遮蔽",
      "原槽位、sequence、ticks、native bounds、origin、受綁區塊與 Main/Sub 映射"
    ]
  },
