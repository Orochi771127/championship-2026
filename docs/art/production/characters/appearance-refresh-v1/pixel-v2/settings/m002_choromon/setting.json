{
  "alternatives": [
    {
      "idea": "瓷白額面＋銅色輪廓內圈＋雙青鏡凹槽；高明度面部與深凹槽保留小尺寸辨識",
      "option": "A",
      "risk": "LOWER：沿用來源主要明暗結構，新花紋只用大面和雙像素帶。",
      "title": "瓷白銅環"
    },
    {
      "idea": "石墨灰殼＋琥珀光學凹槽＋米灰前板，表面採霧黑機械材質",
      "option": "B",
      "risk": "HIGHER：原生窄暗部較多，石墨殼容易讓天線與身體邊緣黏在一起。",
      "title": "石墨琥珀"
    }
  ],
  "classification": "RESEARCH_ONLY",
  "designVersion": "pixel-v2-m002-a-stage2-r02",
  "entityId": "m002_choromon",
  "faceRules": [
    "正面青鏡沿來源兩個有色凹槽區域重新設計；不宣稱來源器官或玩法功能",
    "Main002 斜側姿態不顯示正面双青鏡，不強行補正臉",
    "壓低姿態縮短額面與凹槽高度，保留來源作用端點"
  ],
  "features": [
    "瓷白楔形額面，取消零碎金屬反光",
    "雙青鏡凹槽取代來源正面鮮紅色區；僅出現在來源可見面",
    "完整銅色邊圈及銅色長尾構件",
    "側面一組雙像素寬銅嵌條，與正面青鏡作區分"
  ],
  "ornamentRules": [
    "不添加新腿、天線、齒輪或活動零件",
    "銅圈和嵌條均是既有輪廓內的表面設計",
    "未知的附掛塊、火紅色變和黑白特殊畫格留到後續逐槽處理"
  ],
