+def water_v3(d, name, shallow, deep, bed_shore=(.56, .54, .38), bed_deep=(.16, .30, .30), foam=(.96, .99, 1.0),
+             depth_px=72.0):
+    """Clear stylised water painted with its own visible bottom (the bed is only ~.14 units deep, too
+    shallow to read through real transparency): sandy shallows with pebbles and weed, caustic light
+    lines that fade with depth, turquoise-to-deep-blue tint, a broken foam line on the shore and a
+    softer wave line a little out. Animated nodes are named hunt-water-phase* (hk.set_phase)."""
+    mat = d.material(name, shallow, .22, .0)
+    nodes, links = mat.node_tree.nodes, mat.node_tree.links
+    sh = nodes.get('Principled BSDF')
+    geo = nodes.new('ShaderNodeNewGeometry')
+    attr = nodes.new('ShaderNodeAttribute')
+    attr.attribute_type = 'GEOMETRY'
+    attr.attribute_name = 'shore'
+    dist = attr.outputs['Fac']
+    depth = _m(nodes, links, 'MINIMUM', _m(nodes, links, 'DIVIDE', dist, depth_px), 1.0)
+    depth_s = _m(nodes, links, 'POWER', depth, .7)
+    # bottom: sand -> darker green-grey with depth, broken by low-frequency mottling
+    mot = _n(nodes, 'ShaderNodeTexNoise', Scale=1.4, Detail=3.0, Roughness=.55)
+    links.new(geo.outputs['Position'], mot.inputs['Vector'])
+    bed = _ramp(nodes, links, depth_s, [(.0, bed_shore), (.55, tuple(.5 * a + .5 * b for a, b in zip(bed_shore, bed_deep))), (1.0, bed_deep)])
+    bed = _mix(nodes, links, .22, bed, mot.outputs['Fac'], 'OVERLAY')
+    # pebbles in the shallows (Voronoi cells, varied tone), fading out with depth
+    peb = _n(nodes, 'ShaderNodeTexVoronoi', Scale=3.2, Randomness=1.0)
+    links.new(geo.outputs['Position'], peb.inputs['Vector'])
+    peb_shape = _ramp(nodes, links, peb.outputs['Distance'], [(.18, (1, 1, 1)), (.30, (0, 0, 0))])
+    peb_gate = _ramp(nodes, links, depth, [(.0, (1, 1, 1)), (.5, (.5, .5, .5)), (.85, (0, 0, 0))])
+    peb_mask = _mix(nodes, links, 1.0, peb_shape, peb_gate, 'MULTIPLY')
+    peb_col = _ramp(nodes, links, peb.outputs['Color'], [(.0, (.30, .30, .27)), (.5, (.66, .62, .52)), (1.0, (.42, .36, .28))])
