+def flower_heads(d, name, points, mats, seed=7):
+    """Small open flowers: a short stem and a five-petal head tilted toward the camera, with a
+    yellow eye; one mesh per petal colour (cheap, one object each)."""
+    import random
+    from . import cage_opus_facility_authoring as fx
+    rnd = random.Random(seed)
+    buckets = {m: ([], []) for m in mats}
+    stems, eyes = ([], []), ([], [])
+    for k, (x, y) in enumerate(points):
+        mat = mats[k % len(mats)]
+        z = rnd.uniform(.13, .24)
+        r = rnd.uniform(1.3, 2.1)
+        sv, sf = stems
+        n = len(sv)
+        sv += [d.world(x - .25, y, 0), d.world(x + .25, y, 0), d.world(x + .1, y - .2, z)]
+        sf.append((n, n + 1, n + 2))
+        verts, faces = buckets[mat]
+        c = len(verts)
+        verts.append(d.world(x, y - .3, z + .02))
+        rot = rnd.uniform(0, math.tau)
+        for j in range(10):
+            a = rot + j * math.tau / 10
+            rr = r if j % 2 == 0 else r * .55
+            verts.append(d.world(x + math.cos(a) * rr, y - .3 + math.sin(a) * rr * .55, z + .04 * math.sin(a)))
+        faces += [(c, c + 1 + j, c + 1 + (j + 1) % 10) for j in range(10)]
+        ev, ef = eyes
+        e = len(ev)
+        ev.append(d.world(x, y - .35, z + .05))
+        for j in range(5):
+            a = j * math.tau / 5
+            ev.append(d.world(x + math.cos(a) * r * .32, y - .35 + math.sin(a) * r * .18, z + .05))
+        ef += [(e, e + 1 + j, e + 1 + (j + 1) % 5) for j in range(5)]
+    for mat, (verts, faces) in list(buckets.items()) + [('hn-tuft-1', stems), ('hn-flower-y', eyes)]:
+        if faces:
+            obj = fx._object(d, f'{name}-{mat}-{len(faces)}', verts, faces, mat, 0.0)
+            obj['huntLayer'] = 'ground'
+
+
+def flower_patches(d, ctx, h, spacing=100.0, per=(12, 24), radius=17.0, seed=61):
+    """HM01x2: wildflower drifts in the meadow (clusters, not an even sprinkle), kept off paths
+    near caves by walk_points' own exclusions."""
+    import random
+    rnd = random.Random(ctx.seed * 13 + seed)
+    pts = []
+    ok = ctx.grid == t.WALK
+    for cx, cy in walk_points(ctx, spacing, ctx.seed + seed, clearance=3.0):
+        for _ in range(rnd.randint(*per)):
+            a, r = rnd.uniform(0, math.tau), radius * rnd.random() ** .7
+            x, y = cx + math.cos(a) * r, cy + math.sin(a) * r * .8
+            tx, ty = int(x // t.TILE), int(y // t.TILE)
+            if 0 <= tx < ok.shape[1] and 0 <= ty < ok.shape[0] and ok[ty, tx]:
+                pts.append((x, y))
+    flower_heads(d, 'ground-flower-drifts', pts, ('hn-flower-y', 'hn-flower-w', 'hn-flower-p', 'hn-flower-w'))
+    hk.tuft_field(d, 'ground-flower-leaves', pts[::2], ('hn-tuft-1', 'hn-tuft-2'), height=(.10, .18), width=.5)
+    ctx.count('flowerDrifts', len(pts))
+
